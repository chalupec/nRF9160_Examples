// To get started, press Ctrl+Space to bring up the completion menu and view the available nodes.

// You can also use the buttons in the sidebar to perform actions on nodes.
// Actions currently available include:

// * Enabling / disabling the node
// * Adding the bus to a bus
// * Removing the node
// * Connecting ADC channels

// For more help, browse the DeviceTree documentation at https://docs.zephyrproject.org/latest/guides/dts/index.html
// You can also visit the nRF DeviceTree extension documentation at https://docs.nordicsemi.com/bundle/nrf-connect-vscode/page/guides/ncs_configure_app.html#devicetree-support-in-the-extension

/ {
	zephyr,user {
		io-channels = <&adc 0 &adc 1 &adc 2 &adc 3 &adc 4 &adc 5 &adc 6>;
	};

	
    chosen {
        zephyr,storage = &storage_partition;
    };

};



&i2c0 {	status = "disabled";};
&spi0 {	status = "disabled";};
&i2c1 {	status = "disabled";};


&uart0_default {
	hw-flow-control = "false";
	
	group1 {
		psels = <NRF_PSEL(UART_TX, 0, 27)>, <NRF_PSEL(UART_RX, 0, 26)>;
	};

};


&uart0 {
	current-speed = <250000>;
};





&arduino_adc {
	io-channel-map = <0 &adc 1>, <1 &adc 2>, <2 &adc 3>, <3 &adc 4>, <4 &adc 5>, <5 &adc 6>;
};

&uart0_sleep {
	group1 {
		psels = <NRF_PSEL(UART_TX, 0, 27)>, <NRF_PSEL(UART_RX, 0, 26)>;
	};
};



&spi1 {
    status = "disabled";
};


/* STEP 2.2 - Change the pin configuration */
&pinctrl {
	spi1_default: spi1_default {
		group1 {
				psels = <NRF_PSEL(SPIM_SCK, 0, 5)>,
						<NRF_PSEL(SPIM_MOSI, 0, 4)>,
						<NRF_PSEL(SPIM_MISO, 0, 1)>;
		};
	};

	spi1_sleep: spi1_sleep {
		group1 {
				psels = <NRF_PSEL(SPIM_SCK, 0, 5)>,
						<NRF_PSEL(SPIM_MOSI, 0, 4)>,
						<NRF_PSEL(SPIM_MISO, 0, 1)>;
				low-power-enable;
		};
	};
};


